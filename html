<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Doc21</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;1,7..72,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>

  :root{
    --ink:#20264a; --ink-soft:#333a6e; --parchment:#f6f1e4; --parchment-deep:#efe7d3;
    --brass:#9c8442; --brass-bright:#c2a668; --slate:#5b6478; --line:#ddd3ba;
    --paper:#fffdf8; --paper-deep:#fbf6ea;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background-color:var(--parchment);
    background-image:
      radial-gradient(1100px 620px at 8% -12%, rgba(255,255,255,.4) 0%, rgba(255,255,255,0) 55%),
      radial-gradient(900px 700px at 100% 0%, rgba(166,124,46,.07) 0%, rgba(166,124,46,0) 50%);
    color:#181c26;
    font-family:'Literata',serif;
    font-size:17.5px;
    line-height:1.7;
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
    font-feature-settings:"kern" 1,"liga" 1;
  }
  ::selection{background:rgba(166,124,46,.28);}

  /* toc */
  .toc{
    max-width:640px;margin:-30px auto 0;background:var(--paper);border:1px solid var(--line);
    border-radius:3px;box-shadow:0 20px 40px -30px rgba(28,36,64,.4);
    padding:26px 32px;display:flex;flex-direction:column;gap:8px;position:relative;z-index:2;
  }
  .toc-label{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.06em;color:var(--slate);margin-bottom:6px;}
  .toc a{color:var(--ink-soft);text-decoration:none;font-size:14.5px;border-bottom:1px dotted transparent;}
  .toc a:hover{border-bottom-color:var(--brass);color:var(--ink);}
  .toc .toc-h2{padding-left:16px;font-size:13.5px;color:var(--slate);}
  .toc .toc-h3{padding-left:32px;font-size:13px;color:#7c86a0;}

  /* body */
  .page{max-width:700px;margin:56px auto 40px;padding:0 24px;}
  .doc-body h1{
    font-family:'Fraunces',serif;font-weight:600;font-size:32px;line-height:1.2;
    margin:52px 0 18px;color:var(--ink);
  }
  .doc-body h2{
    font-family:'Fraunces',serif;font-weight:600;font-size:25px;line-height:1.25;
    margin:44px 0 14px;color:var(--ink);border-top:1px solid var(--line);padding-top:28px;
  }
  .doc-body h3{
    font-family:'Fraunces',serif;font-weight:600;font-size:19.5px;margin:32px 0 10px;color:var(--ink-soft);
  }
  .doc-body > *:first-child{margin-top:0;}
  .doc-body p{margin:0 0 18px;color:#181c26;letter-spacing:.001em;}
  .doc-body ul, .doc-body ol{margin:0 0 18px;padding-left:28px;color:#181c26;}
  .doc-body li{margin-bottom:6px;}
  .doc-body a{color:var(--brass);}
  .doc-body strong{color:var(--ink);}
  .doc-body blockquote{
    margin:24px 0;padding:4px 0 4px 20px;border-left:3px solid var(--brass);
    color:var(--slate);font-style:italic;
  }
  .doc-body hr{border:none;border-top:1px solid var(--line);margin:36px 0;}

  .table-wrap{
    overflow-x:auto;margin:32px 0;border-radius:8px;
    border:1px solid var(--line);
    box-shadow:0 24px 48px -26px rgba(28,36,64,.5), 0 1px 2px rgba(28,36,64,.06);
    background:var(--paper);
  }
  table.doc-table{
    border-collapse:separate;border-spacing:0;width:100%;font-size:14.5px;
    font-family:'Literata',serif;background:var(--paper);
    font-variant-numeric:tabular-nums lining-nums;
  }
  table.doc-table thead th, table.doc-table tr:first-child th{
    background:linear-gradient(180deg,var(--ink) 0%,var(--ink-soft) 100%);color:#f6f2e4;
    text-align:left;padding:14px 18px;font-weight:600;position:sticky;top:0;z-index:1;
    font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.05em;text-transform:uppercase;
    border-right:1px solid rgba(255,255,255,.1);
  }
  table.doc-table thead th:first-child{border-top-left-radius:7px;}
  table.doc-table thead th:last-child{border-right:none;border-top-right-radius:7px;}
  table.doc-table td, table.doc-table th{
    padding:12px 18px;
    border-bottom:1px solid #e4d9ba;
    border-right:1px solid #ecdfc0;
    color:#181c26;
  }
  table.doc-table td:last-child, table.doc-table th:last-child{border-right:none;}
  table.doc-table tbody tr:last-child td{border-bottom:none;}
  table.doc-table tbody tr:nth-child(even){background:var(--paper-deep);}
  table.doc-table tbody tr:nth-child(odd){background:var(--paper);}
  table.doc-table tbody tr{transition:background .12s ease;}
  table.doc-table tbody tr:hover{background:#f2e6c8;}
  table.doc-table caption{
    caption-side:bottom;text-align:left;padding:10px 18px;font-size:12px;color:var(--slate);
    font-style:italic;border-top:1px solid var(--line);
  }

  /* inline code / equations / formulas */
  .doc-body code{
    font-family:'JetBrains Mono',monospace;font-size:.88em;background:var(--parchment-deep);
    padding:2px 6px;border-radius:4px;color:var(--ink);border:1px solid var(--line);
  }
  .doc-body pre{
    background:#181c26;color:#e8e4d6;padding:20px 22px;border-radius:8px;overflow-x:auto;
    margin:28px 0;box-shadow:0 24px 48px -26px rgba(28,36,64,.55);font-size:13.5px;line-height:1.6;
  }
  .doc-body pre code{background:none;border:none;padding:0;color:inherit;}
  .doc-body .equation, .doc-body .formula{
    display:block;margin:26px 0;padding:18px 24px;background:var(--paper);border:1px solid var(--line);
    border-left:3px solid var(--brass);border-radius:0 6px 6px 0;text-align:center;
    box-shadow:0 16px 32px -22px rgba(28,36,64,.4);font-family:'Literata',serif;font-size:16.5px;
  }

  figure.doc-image, figure.page-shot{
    margin:40px 0;text-align:center;
  }
  figure.doc-image .frame, figure.page-shot .frame{
    display:inline-block;background:var(--paper);padding:16px;border-radius:10px;
    border:1px solid var(--line);
    box-shadow:0 36px 60px -28px rgba(28,36,64,.55), 0 4px 12px -4px rgba(28,36,64,.15), 0 0 0 1px rgba(28,36,64,.03);
    max-width:100%;transition:transform .18s ease, box-shadow .18s ease;
  }
  figure.doc-image img, figure.page-shot img{
    display:block;max-width:100%;height:auto;border-radius:4px;
  }
  figure.doc-image figcaption, figure.page-shot figcaption{
    margin-top:14px;font-size:12.5px;color:var(--slate);font-style:italic;
    letter-spacing:.01em;
  }
  figure.page-shot{page-break-after:always;}

  .colophon{
    max-width:700px;margin:20px auto 60px;padding:0 24px;color:var(--slate);
    font-size:12.5px;font-family:'JetBrains Mono',monospace;border-top:1px solid var(--line);padding-top:18px;
  }

  /* library shelf */
  .library{display:none;max-width:900px;margin:-30px auto 0;padding:0 24px;position:relative;z-index:2;}
  .library.active{display:block;}
  .library-head{
    display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;
    background:var(--paper);border:1px solid var(--line);border-radius:6px 6px 0 0;
    padding:20px 26px;box-shadow:0 20px 40px -30px rgba(28,36,64,.4);
  }
  .library-eyebrow{font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:.06em;color:var(--slate);}
  .lib-search{
    font-family:'Literata',serif;font-size:14px;padding:9px 14px;border:1px solid var(--line);
    border-radius:20px;background:var(--parchment);color:var(--ink);min-width:200px;outline:none;
  }
  .lib-search:focus{border-color:var(--brass);}
  .library-grid{
    display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1px;
    background:var(--line);border:1px solid var(--line);border-top:none;border-radius:0 0 6px 6px;
    overflow:hidden;box-shadow:0 30px 50px -30px rgba(28,36,64,.5);
  }
  .lib-card{
    display:flex;flex-direction:column;align-items:flex-start;gap:6px;text-align:left;
    background:var(--paper);border:none;padding:22px 20px;cursor:pointer;font-family:'Literata',serif;
    transition:background .12s ease;min-height:150px;
  }
  .lib-card:hover{background:var(--parchment-deep);}
  .lib-num{
    font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--brass);letter-spacing:.05em;
  }
  .lib-card-title{
    font-family:'Fraunces',serif;font-weight:600;font-size:17px;color:var(--ink);line-height:1.3;
  }
  .lib-card-snip{font-size:13px;color:var(--slate);line-height:1.5;flex:1;}
  .lib-card-meta{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--slate);opacity:.8;}

  /* individual chapter view */
  .chapter{display:none;max-width:700px;margin:40px auto 0;padding:0 24px;}
  .chapter.active{display:block;}
  .chapter-nav{
    display:flex;align-items:center;justify-content:space-between;gap:12px;margin:18px 0;
  }
  .chapter-nav.top{margin-bottom:30px;}
  .lib-back, .chap-step{
    font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.02em;
    background:transparent;border:1px solid var(--line);color:var(--ink-soft);
    padding:8px 16px;border-radius:20px;cursor:pointer;
  }
  .lib-back:hover, .chap-step:hover{border-color:var(--brass);color:var(--ink);}
  .chapter-count{font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--slate);}
  .chapter .doc-body h1:first-child, .chapter .doc-body h2:first-child{margin-top:0;border-top:none;padding-top:0;}

  @media print{
    .library{display:none !important;}
    .chapter{display:block !important;max-width:none;}
    .chapter-nav{display:none !important;}
  }

  @media (max-width:640px){
    .book{width:250px;height:340px;}
    .doc-body h1{font-size:26px;}
    .doc-body h2{font-size:21px;}
    .library-grid{grid-template-columns:1fr;}
  }
  
</style>
</head>
